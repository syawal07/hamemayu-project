<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Serve existing files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    
    # Serve existing directories
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # Everything else to index.php
    RewriteRule ^ index.php [L]
</IfModule>
